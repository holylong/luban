{
  "name": "luban",
  "version": "2.9.11",
  "description": "Standalone Node.js agent with Free-style TUI, native LAN mesh, jobs, sync, and Web workspace",
  "license": "MIT",
  "author": "luban contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/holylong/luban.git"
  },
  "homepage": "https://github.com/holylong/luban#readme",
  "bugs": {
    "url": "https://github.com/holylong/luban/issues"
  },
  "keywords": [
    "agent",
    "coding-agent",
    "tui",
    "cli",
    "mesh",
    "llm"
  ],
  "type": "module",
  "bin": {
    "luban": "dist/cli.js"
  },
  "files": [
    "dist",
    "assets/luban-mascot.png",
    "assets/luban-mascot.prompt.md",
    "scripts/patch-ink.mjs",
    "scripts/lib/ink-text-cache.mjs",
    "docs",
    "README.md",
    "bot.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "postinstall": "node scripts/patch-ink.mjs",
    "dev": "tsx src/cli.tsx",
    "web": "tsx src/cli.tsx web",
    "build": "node scripts/build.mjs",
    "start": "node dist/cli.js",
    "desktop": "electron apps/desktop",
    "creator": "electron apps/creator",
    "test": "vitest run",
    "smoke:desktop": "npm run build && node scripts/smoke-desktop-windows.cjs",
    "probe:desktop:terminal": "node scripts/desktop-terminal-probe.cjs",
    "probe:desktop:recovery": "node scripts/probe-desktop-recovery.cjs",
    "probe:desktop:editor": "node scripts/probe-desktop-editor.cjs",
    "smoke:creator": "node scripts/smoke-creator.mjs",
    "smoke:creator:blank": "node scripts/smoke-creator-blank.mjs",
    "smoke:creator:drive": "node scripts/smoke-creator-drive.mjs",
    "release": "node scripts/release.mjs",
    "publish:release": "node scripts/publish-release.mjs",
    "test:release": "node --test scripts/release.test.mjs scripts/release-notes.test.mjs scripts/windows-installer.test.mjs",
    "test:publish": "node --test scripts/publish-release.test.mjs",
    "notes:release": "node scripts/release-notes.mjs",
    "test:android": "node --test scripts/android-navigation.test.mjs",
    "eval": "tsx src/evals/run.ts",
    "package:vscode": "node scripts/package-vscode.mjs",
    "package:linux": "node scripts/package-linux.mjs",
    "package:linux:cli": "node scripts/package-linux.mjs cli",
    "package:linux:desktop": "node scripts/package-linux.mjs desktop",
    "package:linux:creator": "node scripts/release.mjs --platform linux --kind creator",
    "package:windows": "node scripts/package-windows.mjs",
    "package:windows:cli": "node scripts/package-windows.mjs cli",
    "package:windows:desktop": "node scripts/package-windows.mjs desktop",
    "package:windows:creator": "node scripts/release.mjs --platform windows --kind creator",
    "package:windows:setup": "node scripts/package-windows.mjs setup",
    "package:macos": "node scripts/package-macos.mjs",
    "package:macos:cli": "node scripts/package-macos.mjs cli",
    "package:macos:desktop": "node scripts/package-macos.mjs desktop",
    "package:macos:creator": "node scripts/package-macos.mjs creator",
    "build:web": "tsc -p tsconfig.client.json && vite build",
    "dev:web": "vite",
    "build:server": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json",
    "probe:desktop:update": "node scripts/probe-desktop-update.cjs",
    "bench": "tsx src/evals/bench-cli.ts"
  },
  "dependencies": {
    "ajv": "8.17.1",
    "chalk": "5.6.2",
    "commander": "14.0.3",
    "fast-glob": "3.3.3",
    "ink": "6.8.0",
    "pngjs": "7.0.0",
    "react": "19.1.9",
    "string-width": "8.2.2",
    "typescript": "5.9.3"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/pngjs": "6.0.5",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.7",
    "@xterm/xterm": "^6.0.0",
    "electron": "44.4.5",
    "esbuild": "0.25.12",
    "postject": "1.0.0-alpha.6",
    "rcedit": "4.0.1",
    "react-dom": "19.1.9",
    "tsx": "4.20.6",
    "vite": "7.3.6",
    "vitest": "3.2.4"
  }
}
