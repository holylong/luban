{
  "name": "luban",
  "version": "1.16.80",
  "description": "Standalone Node.js agent with Free-style TUI, native LAN mesh, jobs, sync, and Web workspace",
  "type": "module",
  "bin": {
    "luban": "dist/cli.js"
  },
  "files": [
    "dist",
    "docs",
    "plugins",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx src/cli.tsx",
    "web": "tsx src/cli.tsx web",
    "build": "node scripts/build.mjs",
    "start": "node dist/cli.js",
    "desktop": "electron apps/desktop",
    "test": "vitest run",
    "eval": "tsx src/evals/run.ts",
    "package:vscode": "node scripts/package-vscode.mjs",
    "package:linux": "node scripts/package-linux.mjs",
    "package:linux:cli": "node scripts/package-linux.mjs cli",
    "package:linux:desktop": "node scripts/package-linux.mjs desktop",
    "package:windows": "node scripts/package-windows.mjs",
    "package:windows:cli": "node scripts/package-windows.mjs cli",
    "package:windows:desktop": "node scripts/package-windows.mjs desktop",
    "build:web": "tsc -p tsconfig.client.json && vite build",
    "dev:web": "vite",
    "build:server": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json"
  },
  "dependencies": {
    "commander": "14.0.3",
    "fast-glob": "3.3.3",
    "ink": "6.8.0",
    "react": "19.1.9",
    "typescript": "5.9.3"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.7",
    "electron": "44.4.5",
    "rcedit": "4.0.1",
    "react-dom": "19.1.9",
    "tsx": "4.20.6",
    "vite": "7.3.6",
    "vitest": "3.2.4"
  }
}
