#!/bin/sh
set -eu
cert_dir=/var/lib/luban/acme/203.0.113.7_ecc
target_dir=/home/deploy/apps/luban/tls
cert="$cert_dir/fullchain.cer"

# IP certificates last about six days. Renew when under three days remain.
if openssl x509 -checkend 259200 -noout -in "$cert" >/dev/null 2>&1; then
  exit 0
fi

systemctl stop luban-relay.service
trap 'systemctl start luban-relay.service' EXIT
/home/deploy/apps/acme/acme.sh/acme.sh --renew -d 203.0.113.7 --ecc --force --server letsencrypt --home /var/lib/luban/acme
install -m 600 -o deploy -g deploy "$cert_dir/203.0.113.7.key" "$target_dir/key.pem"
install -m 644 -o deploy -g deploy "$cert" "$target_dir/fullchain.pem"
