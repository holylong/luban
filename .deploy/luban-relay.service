[Unit]
Description=Luban public phone relay
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=skyer
Group=skyer
WorkingDirectory=/home/skyer/apps/luban
EnvironmentFile=/home/skyer/.config/luban/relay.env
ExecStart=/usr/local/bin/node /home/skyer/apps/luban/dist/cli.js relay --host 0.0.0.0 --port 443 --public-url https://39.105.10.158 --https --tls-key /home/skyer/apps/luban/tls/key.pem --tls-cert /home/skyer/apps/luban/tls/fullchain.pem
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
Restart=always
RestartSec=3
KillSignal=SIGINT
StandardOutput=null

[Install]
WantedBy=multi-user.target
