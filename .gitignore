# dependencies
node_modules/
.npm-cache/

# build output
dist/
release/
# `npm pack` leftovers: they are build output, not sources
*.tgz
coverage/
*.vsix

# logs
*.log

# local agent runtime state (sessions, job store, sync state, logs)
.luban/
.smoke/
.run/

# private deployment/ops files (systemd units, cert renewal, ssh helpers)
.deploy/

# local probe scratch (heap snapshots and replays can contain credentials)
.probe/
*.heapsnapshot

# python bytecode
__pycache__/
*.pyc
*.pyo

# local / private config (config.example.json is the shareable template)
config.json
config.exp.json

# personal scratch output (e.g. screenshot base64 dump)
*.b64

# session transcripts and exports (contain local paths, node names, session ids)
session-*.md
luban-export-*.md
*-export-*.md

# local Kev decision-server scratch (launch script, logs, config backup with keys)
.kev/

# OS junk
.DS_Store
Thumbs.db

# local intro video assets (not shipped with the CLI)
/images/
/introduce.txt
workbuddy.jpg

# Android build output and the machine-local SDK path
apps/android-native/.gradle/
apps/android-native/build/
apps/android-native/app/build/
apps/android-native/local.properties
