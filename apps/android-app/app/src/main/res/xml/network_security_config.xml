<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- The relay address is configured at runtime. LAN HTTP is supported;
         HTTPS accepts only system or explicitly installed user CAs. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
