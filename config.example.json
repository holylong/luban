{
  "node": {
    "name": "my-laptop",
    "host": "0.0.0.0",
    "port": 17890,
    "udp_port": 7891,
    "capabilities": [
      "linux",
      "shell",
      "files",
      "agent",
      "audio"
    ]
  },
  "model": {
    "max_tokens": 32768,
    "temperature": 0.2,
    "top_p": 1,
    "top_k": 0,
    "timeout": 300,
    "thinking_timeout": 600,
    "max_retries": 5,
    "context_window": 262144,
    "max_history_messages": 120,
    "active": "codex/gpt-6-sol",
    "reasoning_effort": "xhigh"
  },
  "providers": {
    "qwen-local": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://127.0.0.1:8000/v1",
        "apiKey": ""
      },
      "models": {
        "qwen3.8-flash-next": {
          "name": "qwen3.8-flash-next"
        }
      }
    },
    "deepseek": {
      "api_key": "",
      "api_key_env": "DEEPSEEK_API_KEY",
      "base_url": "https://api.deepseek.com/chat/completions",
      "models": [
        "deepseek-flash",
        "deepseek-v4-pro"
      ]
    },
    "dashscope": {
      "api_key": "",
      "api_key_env": "DASHSCOPE_API_KEY",
      "base_url": "https://dashscope.aliyuncs.com/compatible-mode/v1",
      "models": [
        "deepseek-v4-flash-0731",
        "deepseek-v4.1-flash",
        "qwen3.8-flash",
        "qwen3.8-max",
        "glm5.3-flash"
      ]
    },
    "opencode-go": {
      "api_key_env": "OPENCODE_API_KEY",
      "base_url": "https://opencode.ai/zen/go/v1",
      "headers": { "x-opencode-session": "luban" },
      "models": {
        "kimi-k3": { "name": "Kimi K3", "api": "openai" },
        "qwen3.8-max": { "name": "Qwen3.8 Max", "api": "openai" },
        "qwen3.8-flash": { "name": "Qwen3.8 Flash", "api": "anthropic" },
        "gpt-6-luna": { "name": "GPT-6 Luna", "api": "responses" }
      }
    },
    "opencode-zen": {
      "api_key_env": "OPENCODE_ZEN_API_KEY",
      "base_url": "https://opencode.ai/zen/v1",
      "models": {
        "ling-3.1-flash-free": { "name": "Ling 3.1 Flash Free", "api": "openai" },
        "muse-spark-1.3-contributor-free": { "name": "Muse Spark 1.3 Contributor Free", "api": "responses", "capabilities": { "temperature": false } }
      }
    }
  },
  "contacts": [
    {
      "name": "peer-1",
      "host": "192.168.1.50",
      "port": 17890,
      "note": "Example LAN peer",
      "udp_port": 7891
    }
  ],
  "sync": {
    "mode": "auto",
    "chunk_size": 65536,
    "ignore": [
      ".git",
      ".luban",
      "__pycache__",
      ".pytest_cache",
      ".ruff_cache",
      ".mypy_cache",
      ".venv",
      "venv",
      "node_modules",
      "target",
      "*.pyc",
      "*.pyo",
      ".DS_Store",
      "*.log"
    ],
    "conflict_policy": "auto"
  },
  "projects": {
    "myapp": "/path/to/myapp"
  },
  "web": {
    "host": "127.0.0.1",
    "port": 8080
  },
  "mcp": {
    "token": "",
    "workspace": ""
  },
  "kev": {
    "mode": "model",
    "url": "",
    "apiKey": "",
    "model": "kev-latest",
    "timeout_seconds": 120
  },
  "max_workers": 12,
  "max_steps": 1000,
  "permission": {
    "mode": "edits"
  },
  "remote": {
    "enabled": false,
    "relay_url": "https://39.10.105.15",
    "node_token_env": "LUBAN_RELAY_NODE_TOKEN",
    "node_token_file": "/home/demo/.config/luban/relay.env",
    "host": "127.0.0.1",
    "port": 0
  }
}
